{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.dobeu.example/schemas/staffing-diagnostic-intake.json",
  "title": "Staffing Operations Automation Diagnostic Intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["intake_id", "submitted_at", "customer_alias", "contact", "workflow", "commercial", "authorization"],
  "properties": {
    "intake_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,63}$"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "evidence_class": {"const": "prospect_supplied"},
    "customer_alias": {"type": "string", "minLength": 2, "maxLength": 80},
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "business_email_present", "process_owner"],
      "properties": {
        "role": {"type": "string", "minLength": 2, "maxLength": 80},
        "business_email_present": {"type": "boolean"},
        "process_owner": {"type": "boolean"}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "weekly_volume", "operator_minutes_per_item", "systems", "data_classes", "human_decisions", "external_actions"],
      "properties": {
        "name": {"type": "string", "minLength": 3, "maxLength": 120},
        "summary": {"type": "string", "minLength": 20, "maxLength": 1000},
        "weekly_volume": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "operator_minutes_per_item": {"type": "number", "minimum": 0, "maximum": 1440},
        "wait_hours_per_item": {"type": ["number", "null"], "minimum": 0, "maximum": 8760},
        "rework_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "systems": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 100}, "uniqueItems": true},
        "data_classes": {"type": "array", "maxItems": 20, "items": {"enum": ["public", "internal", "business_contact", "applicant_pii", "resume", "employment", "financial", "health", "credential", "unknown"]}, "uniqueItems": true},
        "human_decisions": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 200}},
        "external_actions": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 200}}
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desired_start_days", "diagnostic_budget_confirmed", "implementation_budget_range"],
      "properties": {
        "desired_start_days": {"type": "integer", "minimum": 0, "maximum": 365},
        "diagnostic_budget_confirmed": {"type": "boolean"},
        "implementation_budget_range": {"enum": ["unknown", "under_1500", "1500_3000", "3000_7500", "over_7500"]}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_authorize_discovery", "production_access_requested", "autonomous_employment_decision_requested", "terms_acknowledged"],
      "properties": {
        "can_authorize_discovery": {"type": "boolean"},
        "production_access_requested": {"type": "boolean"},
        "autonomous_employment_decision_requested": {"type": "boolean"},
        "terms_acknowledged": {"type": "boolean"}
      }
    }
  }
}
